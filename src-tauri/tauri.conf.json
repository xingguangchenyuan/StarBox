{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarBox",
  "version": "0.1.0",
  "identifier": "com.starbox.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "星匣 StarBox",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": true,
        "backgroundColor": "#0a0f15"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/StarBox/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "本机游戏库管家",
    "longDescription": "星匣 StarBox 把散落在硬盘各处的游戏收进一堵封面墙，一键启动并盯住进程，同时缓存 Steam 的游戏资料与成就定义。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
