{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "星匣主窗口权限：文件选择、打开目录、事件监听",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir"
  ]
}
